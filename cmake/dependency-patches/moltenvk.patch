--- /dev/null
+++ b/MoltenVK/MoltenVK/Commands/MVKMTLBufferRetention.h
@@ -0,0 +1,32 @@
+/*
+ * Copyright (c) 2026 LibertyRecomp contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+#import <Metal/Metal.h>
+#include <unordered_set>
+
+// Owns the extra Metal dependencies introduced by conservative BDA enumeration.
+// Encoding is single-writer, and completion cannot run until encoding has ended.
+// This object must not own its command buffer, queue, or device.
+class MVKMTLBufferRetention {
+public:
+	MVKMTLBufferRetention() = default;
+	MVKMTLBufferRetention(const MVKMTLBufferRetention&) = delete;
+	MVKMTLBufferRetention& operator=(const MVKMTLBufferRetention&) = delete;
+	~MVKMTLBufferRetention();
+
+	// Call while the device resource lock still protects the buffer lookup.
+	void retainBuffer(id<MTLBuffer> buffer);
+	void clear();
+
+private:
+	std::unordered_set<id<MTLBuffer>> _buffers;
+};
+
+// Borrowed state owned by this actual Metal command buffer, including prefilled
+// buffers. Repeated Vulkan encoders/passes share the same deduplicated ownership.
+// Returns nullptr for a failed (nil) command-buffer allocation.
+MVKMTLBufferRetention* mvkGetMTLBufferRetention(id<MTLCommandBuffer> commandBuffer);
diff --git a/MoltenVK/MoltenVK/Commands/MVKMTLBufferRetention.mm b/MoltenVK/MoltenVK/Commands/MVKMTLBufferRetention.mm
new file mode 100644
index 0000000000000000000000000000000000000000..48c02db979c54138283aad86034c6b8ff6ff4152
--- /dev/null
+++ b/MoltenVK/MoltenVK/Commands/MVKMTLBufferRetention.mm
@@ -0,0 +1,54 @@
+/*
+ * Copyright (c) 2026 LibertyRecomp contributors
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "MVKMTLBufferRetention.h"
+#import <objc/runtime.h>
+
+MVKMTLBufferRetention::~MVKMTLBufferRetention() { clear(); }
+
+void MVKMTLBufferRetention::retainBuffer(id<MTLBuffer> buffer) {
+	if (buffer && _buffers.insert(buffer).second) { [buffer retain]; }
+}
+
+void MVKMTLBufferRetention::clear() {
+	// Drop both resources and bookkeeping at completion, even if Metal keeps its
+	// command-buffer wrapper alive. Swapping first also makes cleanup idempotent.
+	decltype(_buffers) buffers;
+	buffers.swap(_buffers);
+	for (id<MTLBuffer> buffer : buffers) { [buffer release]; }
+}
+
+@interface MVKMTLBufferRetentionOwner : NSObject {
+@public
+	MVKMTLBufferRetention retention;
+}
+@end
+
+@implementation MVKMTLBufferRetentionOwner
+- (void)dealloc {
+	// Also handles a command buffer discarded without invoking its handlers.
+	retention.clear();
+	[super dealloc];
+}
+@end
+
+MVKMTLBufferRetention* mvkGetMTLBufferRetention(id<MTLCommandBuffer> commandBuffer) {
+	if (!commandBuffer) { return nullptr; }
+	static char associationKey;
+	MVKMTLBufferRetentionOwner* owner =
+		(MVKMTLBufferRetentionOwner*)objc_getAssociatedObject(commandBuffer, &associationKey);
+	if (!owner) {
+		owner = [MVKMTLBufferRetentionOwner new];
+		objc_setAssociatedObject(commandBuffer, &associationKey, owner,
+								 OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+		// Capture only the owner: capturing commandBuffer would form a retain
+		// cycle. Error completions release resources just like successful ones.
+		[commandBuffer addCompletedHandler: ^(id<MTLCommandBuffer>) {
+			owner->retention.clear();
+		}];
+		[owner release];
+	}
+	return &owner->retention;
+}
