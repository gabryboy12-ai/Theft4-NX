+#elif defined(__ORBIS__) && _LIBCPP_HAS_THREAD_API_PTHREAD
+// OpenOrbis musl aliases SYS_gettid → SYS_getpid (FreeBSD has no gettid
+// syscall — the real per-thread call is SYS_thr_self=432, which musl does
+// not expose). The generic SYS_gettid branch below would therefore return
+// the same value (the process pid) for every thread, and libc++abi's
+// __cxa_guard_acquire recursion check (`*thread_id_address == current_thread_id`)
+// would fire on every cross-thread static-init race. Use the pthread_self()
+// pointer as a per-thread ID source instead — each guest thread has a unique
+// TCB pointer, the low 32 bits are sufficiently unique in practice.
+uint32_t PlatformThreadID() {
+  return static_cast<uint32_t>(reinterpret_cast<uintptr_t>(pthread_self()));
+}
