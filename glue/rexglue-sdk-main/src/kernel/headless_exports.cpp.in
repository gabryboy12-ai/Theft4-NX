// Diagnostic-only exports for the opt-in headless kernel. These are not
// implementations: any call stops with the exact API and guest caller
// (rex::diagnostics::StopAtMissingFunction; the executable may override it).
#include <rex/diagnostics/missing_function.h>
#include <rex/hook.h>

REXCVAR_DEFINE_BOOL(headless, true, "UI", "Disable host dialogs in the headless startup build");

#define REX_HEADLESS_UNAVAILABLE(name)                                      \
  REX_HOOK_RAW(name) {                                                     \
    (void)base;                                                           \
    rex::diagnostics::StopAtMissingFunction(                              \
        "Xbox export unavailable in the headless kernel", #name,          \
        uint32_t(ctx.lr));                                                \
  }                                                                       \
  static rex::ppc::detail::PPCFuncRegistrar _headless_##name(#name, &name);

@HEADLESS_EXPORT_GUARDS@
